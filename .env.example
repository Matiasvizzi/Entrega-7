# Copiá este archivo como .env y completá tu key (gratis en https://aistudio.google.com/apikey)
GOOGLE_API_KEY=tu_api_key_aqui

# Redis: estado de los jobs + checkpoints de LangGraph (cualquier Redis 5+; no requiere módulos)
REDIS_URL=redis://localhost:6379/0

# Observabilidad (Arize Phoenix). OBSERVABILIDAD=off la desactiva.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=ba-explore-api

# Opcional
# GEMINI_MODEL=gemini-flash-lite-latest
# MAX_JOBS_CONCURRENTES=5
# JOB_TIMEOUT_S=420
# LangSmith (alternativa a Phoenix): LANGSMITH_TRACING=true y LANGSMITH_API_KEY=...
